# Database (Supabase PostgreSQL; see scripts/db-move/neon-to-supabase.sh)
# Runtime: Supavisor transaction mode (port 6543). pgbouncer=true turns off Prisma's
# prepared statements, which transaction pooling does not support.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
# Schema changes (prisma db push) and Universal App provisioning: session mode (port 5432).
# Use the pooler, not db.PROJECT_REF.supabase.co: the direct host is IPv6-only on free plans.
DATABASE_URL_UNPOOLED="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-random-secret-here"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Transactional email for native order notifications
RESEND_API_KEY=""
APPAI_EMAIL_FROM="AppAI Orders <orders@yourdomain.com>"

# Optional static credential for local or non-Vercel private Blob access.
# Vercel deployments use the connected store's short-lived OIDC identity and
# auto-managed BLOB_STORE_ID instead; do not reuse a public store token.
PRIVATE_BLOB_READ_WRITE_TOKEN=""
PRIVATE_ASSET_MAX_FILE_BYTES="2097152"
PRIVATE_ASSET_ORG_LIMIT_BYTES="104857600"
PRIVATE_ASSET_LARGE_FILE_BYTES="524288"

# Web feedback requires both Turnstile keys in production; optional in development.
# Notification requires FEEDBACK_NOTIFY_EMAIL, RESEND_API_KEY and APPAI_EMAIL_FROM.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
FEEDBACK_IP_SALT=
FEEDBACK_NOTIFY_EMAIL=
